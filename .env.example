# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Gmail OTP Delivery — set GMAIL_APP_PASSWORD in Settings -> Secrets to send live OTP emails via Gmail
GMAIL_APP_PASSWORD=

# Optional custom SMTP overrides (defaults to smtp.gmail.com when GMAIL_APP_PASSWORD is set)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LedgerFlow Security <shakti.chahar@gmail.com>"

# Free Google Apps Script OTP Email Webhook (works for both Web Server & Standalone Android APK)
OTP_EMAIL_WEBHOOK_URL=
OTP_EMAIL_WEBHOOK_SECRET=

# OTP SMS Delivery (Twilio) — configure in Settings -> Secrets to send live mobile SMS OTPs
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
